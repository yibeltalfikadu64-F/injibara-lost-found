
# ==========================================================
# INJIBARA CAMPUS LOST & FOUND
# BACKEND ENVIRONMENT CONFIGURATION
# ==========================================================

# ----------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------

NODE_ENV=development

APP_NAME=Injibara Campus Lost and Found

PORT=5000

API_PREFIX=/api/v1

APP_URL=http://localhost:5000

CLIENT_URL=http://localhost:8081

# ----------------------------------------------------------
# DATABASE - POSTGRESQL
# ----------------------------------------------------------

DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/campus_lost_found?schema=public

POSTGRES_HOST=localhost

POSTGRES_PORT=5432

POSTGRES_USER=postgres

POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD

POSTGRES_DB=campus_lost_found

# ----------------------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------------------

JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_EXPIRES_IN=7d

JWT_ISSUER=injibara-campus-lost-found

JWT_AUDIENCE=injibara-campus-users

# ----------------------------------------------------------
# PASSWORD SECURITY
# ----------------------------------------------------------

PASSWORD_MIN_LENGTH=8

PASSWORD_MAX_LENGTH=128

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------

CORS_ORIGIN=http://localhost:8081,http://localhost:5173,http://localhost:19006

# ----------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_WINDOW_MS=900000

AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ----------------------------------------------------------
# FILE UPLOADS
# ----------------------------------------------------------

UPLOAD_DIRECTORY=./uploads

UPLOAD_MAX_FILE_SIZE=8388608

UPLOAD_MAX_FILES=5

UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ----------------------------------------------------------
# EMAIL CONFIGURATION
# ----------------------------------------------------------

MAIL_HOST=

MAIL_PORT=587

MAIL_SECURE=false

MAIL_USER=

MAIL_PASSWORD=

MAIL_FROM_NAME=Injibara Campus Lost and Found

MAIL_FROM_ADDRESS=

# ----------------------------------------------------------
# EMAIL VERIFICATION
# ----------------------------------------------------------

EMAIL_VERIFICATION_EXPIRES_IN=24h

# ----------------------------------------------------------
# PASSWORD RESET
# ----------------------------------------------------------

PASSWORD_RESET_EXPIRES_IN=15m

# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------

LOG_LEVEL=debug

LOG_REQUESTS=true

# ----------------------------------------------------------
# OPTIONAL ADMIN BOOTSTRAP
# ----------------------------------------------------------

ADMIN_BOOTSTRAP_ENABLED=false

ADMIN_BOOTSTRAP_NAME=

ADMIN_BOOTSTRAP_EMAIL=

ADMIN_BOOTSTRAP_PASSWORD=
